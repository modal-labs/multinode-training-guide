diff --git a/nemo_automodel/components/checkpoint/checkpointing.py b/nemo_automodel/components/checkpoint/checkpointing.py
--- a/nemo_automodel/components/checkpoint/checkpointing.py
+++ b/nemo_automodel/components/checkpoint/checkpointing.py
@@ -1139,7 +1139,8 @@ class Checkpointer:
         """
         Save a state dictionary to `path` using DCP or PEFT special-case logic.
 
-        - For PEFT model saves: only rank 0 writes `adapter_model.safetensors`.
+        - For PEFT model saves without PP: rank 0 writes `adapter_model.safetensors`.
+        - For PEFT model saves with PP: one rank per stage writes a stage shard.
         - If async mode is enabled, schedule an asynchronous save.
 
         Args:
@@ -1156,10 +1157,37 @@ class Checkpointer:
         is_model = True if "/model" in path else False
         # PEFT saving is done on rank0 so it is a special case
         if self.config.is_peft and is_model:
-            if not torch.distributed.is_initialized() or torch.distributed.get_rank() == 0:
+            if not torch.distributed.is_initialized():
                 _save_safetensors(state_dict, _adapter_path(path))
-            if torch.distributed.is_initialized():
-                torch.distributed.barrier()
+                return
+
+            rank = torch.distributed.get_rank()
+            world_size = torch.distributed.get_world_size()
+            rank_and_stage = [None] * world_size
+            torch.distributed.all_gather_object(
+                rank_and_stage, (rank, self.pp_rank)
+            )
+            writer_by_stage = {}
+            for global_rank, pp_rank in rank_and_stage:
+                writer_by_stage.setdefault(pp_rank, global_rank)
+                writer_by_stage[pp_rank] = min(
+                    writer_by_stage[pp_rank], global_rank
+                )
+
+            if len(writer_by_stage) == 1:
+                if rank == 0:
+                    _save_safetensors(state_dict, _adapter_path(path))
+            elif rank == writer_by_stage[self.pp_rank]:
+                adapter_path = _adapter_path(path)
+                stem, suffix = os.path.splitext(adapter_path)
+                stage_path = (
+                    f"{stem}.pp-{self.pp_rank:05d}-of-"
+                    f"{len(writer_by_stage):05d}{suffix}"
+                )
+                _save_safetensors(state_dict, stage_path)
+                logger.info("Saved pipeline-stage PEFT adapter to %s", stage_path)
+
+            torch.distributed.barrier()
             return
 
         ret = None
