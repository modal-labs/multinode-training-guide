+inline int oob_socket_family() {
+  char const* family = getenv("UCCL_SOCKET_FAMILY");
+  if (family == nullptr) family = getenv("NCCL_SOCKET_FAMILY");
+  return family != nullptr && strcmp(family, "AF_INET6") == 0 ? AF_INET6
+                                                               : AF_INET;
+}
+
+inline socklen_t make_oob_any_address(int family, uint16_t port,
+                                      struct sockaddr_storage* storage) {
+  memset(storage, 0, sizeof(*storage));
+  if (family == AF_INET6) {
+    auto* addr = reinterpret_cast<struct sockaddr_in6*>(storage);
+    addr->sin6_family = AF_INET6;
+    addr->sin6_addr = in6addr_any;
+    addr->sin6_port = htons(port);
+    return sizeof(*addr);
+  }
+
+  auto* addr = reinterpret_cast<struct sockaddr_in*>(storage);
+  addr->sin_family = AF_INET;
+  addr->sin_addr.s_addr = INADDR_ANY;
+  addr->sin_port = htons(port);
+  return sizeof(*addr);
+}
+
+inline socklen_t make_oob_socket_address(char const* ip, uint16_t port,
+                                         struct sockaddr_storage* storage) {
+  memset(storage, 0, sizeof(*storage));
+  if (strchr(ip, ':') != nullptr) {
+    auto* addr = reinterpret_cast<struct sockaddr_in6*>(storage);
+    addr->sin6_family = AF_INET6;
+    addr->sin6_port = htons(port);
+    UCCL_CHECK(inet_pton(AF_INET6, ip, &addr->sin6_addr) == 1)
+        << "Invalid IPv6 OOB address " << ip;
+    return sizeof(*addr);
+  }
+
+  auto* addr = reinterpret_cast<struct sockaddr_in*>(storage);
+  addr->sin_family = AF_INET;
+  addr->sin_port = htons(port);
+  UCCL_CHECK(inet_pton(AF_INET, ip, &addr->sin_addr) == 1)
+      << "Invalid IPv4 OOB address " << ip;
+  return sizeof(*addr);
+}
+
+inline uint16_t oob_socket_port(struct sockaddr_storage const& storage) {
+  if (storage.ss_family == AF_INET6) {
+    auto const* addr = reinterpret_cast<struct sockaddr_in6 const*>(&storage);
+    return ntohs(addr->sin6_port);
+  }
+  auto const* addr = reinterpret_cast<struct sockaddr_in const*>(&storage);
+  return ntohs(addr->sin_port);
+}
